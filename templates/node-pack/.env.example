#=====================================================================#
#                       The pack                                      #
#=====================================================================#

# The pack's directory name inside ComfyUI (/app/custom_nodes/<PACK_NAME>).
# Its nodes report python_module "custom_nodes.<PACK_NAME>", and dev-check.sh
# reads it from here. Use the repository's name.
PACK_NAME=my-node-pack

#=====================================================================#
#                       Image                                         #
#=====================================================================#

# Unset, it is core:cpu-latest, or core:cuda-latest with the GPU overlay below.
# A release tag (core:cpu-X.Y.Z, core:cuda-X.Y.Z) keeps the ComfyUI you test
# against fixed. For NVIDIA, uncomment COMPOSE_FILE.
# COMFY_IMAGE=ghcr.io/pixeloven/comfyui/core:cpu-X.Y.Z
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

#=====================================================================#
#                       Server                                        #
#=====================================================================#

# The UID/GID ComfyUI runs as. Match your host user (`id -u`, `id -g`).
PUID=1000
PGID=1000

# Published on 127.0.0.1 only. dev-check.sh reads it from here too.
COMFY_PORT=8188
COMFY_ENABLE_MANAGER=true
COMFY_ENABLE_ASSETS=true
# Load only this pack:
# CLI_ARGS=--disable-all-custom-nodes --whitelist-custom-nodes my-node-pack
CLI_ARGS=

#=====================================================================#
#                       Data (optional)                               #
#=====================================================================#

# Each defaults to a named volume of this Compose project. Set one to a host
# path to share it, for example the models of another ComfyUI.
# COMFY_MODEL_PATH=/path/to/models
# COMFY_CUSTOM_NODE_PATH=
# COMFY_DATASET_PATH=
# COMFY_INPUT_PATH=
# COMFY_OUTPUT_PATH=
# COMFY_TEMP_PATH=
# COMFY_USER_PATH=

# Only for the optional mcp service in docker-compose.yml.
# COMFYUI_MCP_HTTP_TOKEN=
