# comfyrelay: the first-party MCP sidecar for one ComfyUI (#103, #131),
# published as ghcr.io/pixeloven/comfyui/mcp since 5.0.0 (#136; bake target
# `mcp`). Standalone Python image; does NOT depend on the ComfyUI runtime
# images. It talks to ComfyUI over HTTP (COMFYUI_URL) and to nothing else.
#
# The build context is services/, the uv workspace root, so the image installs
# exactly what services/uv.lock pins, hash-checked. comfyctl is the command:
# `comfyctl relay serve` mounts comfyrelay, and comfyfetch comes with comfyctl.
# dockerfile.comfy.relay.dockerignore, beside this file, is the context filter.

# The uv that installs from the lock. Build stage only.
FROM ghcr.io/astral-sh/uv:0.11.23@sha256:d0a0a753ab981624b49c97abc98821c1c09f4ca69d1ef5cee69c501be3d88479 AS uv

FROM python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b AS builder
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=/usr/local/bin/python3 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1
WORKDIR /src
# The lock and every member's pyproject first, so the dependency layer only
# rebuilds when they change. --frozen installs the lock as written and fails
# rather than re-resolving; every wheel is checked against its lock hash.
COPY pyproject.toml uv.lock ./
COPY fetch/pyproject.toml fetch/
COPY comfyctl/pyproject.toml comfyctl/README.md comfyctl/
COPY comfyrelay/pyproject.toml comfyrelay/README.md comfyrelay/
# SPIKE (#167): RELAY_CONVERT=1 adds comfyrelay's `convert` extra (Playwright)
# and, in the final stage, a headless Chromium. Unset, the image is as before.
ARG RELAY_CONVERT=
RUN uv sync --frozen --no-dev --all-packages --no-install-workspace \
      $([ "$RELAY_CONVERT" = 1 ] && echo --extra convert)
# Then the three workspace members themselves, not editable, so /src can go.
COPY fetch/comfyfetch fetch/comfyfetch
COPY comfyctl/comfyctl comfyctl/comfyctl
COPY comfyrelay/comfyrelay comfyrelay/comfyrelay
RUN uv sync --frozen --no-dev --all-packages --no-editable \
      $([ "$RELAY_CONVERT" = 1 ] && echo --extra convert)
# The SDK's own `mcp` command (mcp.cli: dev, run, install, which can write a
# Claude Desktop config) comes with the SDK wheel whether or not its [cli]
# extra is installed, and so does its --env-file dotenv loader. The relay uses
# neither, so both go from the venv. python-dotenv itself is not installed (it
# comes only with that extra); the last check fails the build if it ever is.
RUN rm /opt/venv/bin/mcp && \
    rm -r "$(/opt/venv/bin/python -c 'import mcp, os; print(os.path.dirname(mcp.__file__))')/cli" && \
    ! /opt/venv/bin/python -c 'import mcp.cli' 2>/dev/null && \
    ! /opt/venv/bin/python -c 'import dotenv' 2>/dev/null

# The docs index (#134) that docs_search and docs_guide read: Comfy-Org/docs at
# COMFY_DOCS_SHA (the bake pin; GPL-3.0) and our guides, skills/comfyui-workflows/
# (MIT), which arrive as the `skills` named context because this context is
# services/. `comfyctl relay docs build` fetches the docs shallow and sparse
# (only docs.json, the snippets and the English pages it lists; no history, no
# media) and writes the index, the markdown it indexed, NOTICE and the GPL text.
# This is the only stage that touches the network after the lock install, and
# the server never does: the docs index is data in the image.
FROM builder AS docs
RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*
ARG COMFY_DOCS_SHA
RUN test -n "$COMFY_DOCS_SHA" || { echo "COMFY_DOCS_SHA is required; build with docker buildx bake" >&2; exit 1; }
COPY --from=skills . /skills
# The commit this image is built from: the guides' URLs and the NOTICE's
# Corresponding Source pointer name it. CI passes it; a build without it
# points them at the release tag of the version it reports. Deliberately
# here, so every new commit rebuilds this stage and re-fetches the docs.
ARG GIT_SHA=
RUN /opt/venv/bin/comfyctl relay docs build --docs-sha "$COMFY_DOCS_SHA" --skills /skills --out /docs \
      --git-sha "$GIT_SHA"

FROM python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b

# tini as PID 1, so `docker stop` and a pod's SIGTERM reach the server at once
# instead of waiting out the grace period. Pinned to the version Debian 13
# (the base image's release) serves. Debian keeps one version per suite, so a
# rebuild of tini there makes this fail loudly rather than install another build:
# move the pin after checking `apt-cache policy tini` in the base image.
RUN apt-get update && \
    apt-get install -y --no-install-recommends tini=0.19.0-3+b8 && \
    rm -rf /var/lib/apt/lists/*

# comfy, 1000:1000. Any other UID works too: the server writes nothing, so a
# read-only root filesystem needs no tmpfs beyond /tmp.
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd -g "$APP_GID" comfy && \
    useradd -u "$APP_UID" -g "$APP_GID" -d /app -s /usr/sbin/nologin -M comfy && \
    mkdir -p /app && chown comfy:comfy /app

COPY --from=builder /opt/venv /opt/venv

# SPIKE (#167): with RELAY_CONVERT=1, Chromium's headless shell and the system
# libraries it needs, at /opt/playwright (convert.py looks there), readable by
# any UID. Unset, this layer does nothing.
ARG RELAY_CONVERT=
RUN if [ "$RELAY_CONVERT" = 1 ]; then \
      PLAYWRIGHT_BROWSERS_PATH=/opt/playwright /opt/venv/bin/playwright install --with-deps --only-shell chromium && \
      rm -rf /var/lib/apt/lists/* /opt/playwright/ffmpeg-* && chmod -R a+rX /opt/playwright; \
    fi

# The docs index is a GPL-3.0 work, shipped with the English markdown it was built
# from (/opt/docs/source), the GPL text and a NOTICE (/licenses). The server's
# code stays MIT; it reads the docs index as a data file.
COPY --from=docs /docs/docs.sqlite /opt/docs/docs.sqlite
COPY --from=docs /docs/source /opt/docs/source
COPY --from=docs /docs/NOTICE /docs/GPL-3.0.txt /licenses/

# The ComfyUI this image serves, from the bake pin, stated the way the ComfyUI
# images state it: the label for `docker inspect`, and COMFYUI_VERSION for the
# process, whose server_info compares it with what the live ComfyUI reports.
ARG COMFYUI_VERSION
RUN test -n "$COMFYUI_VERSION" || { echo "COMFYUI_VERSION is required; build with docker buildx bake" >&2; exit 1; }
LABEL org.opencontainers.image.source="https://github.com/pixeloven/ComfyUI-Docker" \
      org.opencontainers.image.description="comfyrelay: an MCP sidecar for one ComfyUI instance. Not affiliated with or endorsed by Comfy Org." \
      org.opencontainers.image.version="$COMFYUI_VERSION" \
      org.opencontainers.image.licenses="MIT AND GPL-3.0"

# The env contract (docs/user-guides/runtime-contract.md). The token
# (COMFYUI_MCP_HTTP_TOKEN) is never set here: without it, or with one under 32
# characters, the server refuses to start.
ENV PATH="/opt/venv/bin:$PATH" \
    HOME=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    COMFYUI_VERSION=$COMFYUI_VERSION \
    COMFYUI_URL=http://localhost:8188 \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=9000 \
    COMFYUI_MCP_PROFILES=read,run

WORKDIR /app
# Numeric (1000:1000 by default), so a runtime that checks for a non-root UID
# (Kubernetes runAsNonRoot) can tell without reading /etc/passwd.
USER ${APP_UID}:${APP_GID}

# Prove it at BUILD time, with the defaults above:
#   - without a token it refuses to start, with exit 2 and the reason;
#   - with one, `comfyctl relay probe` passes against it: 401 without the
#     token, then initialize, tools/list and server_info, and the docs index:
#     server_info.docs is built and docs_search finds something. There is no
#     ComfyUI here, so --no-comfyui: reaching ComfyUI is the integration test's
#     job.
RUN set -u; \
    comfyctl --version > /dev/null && comfyctl relay --help > /dev/null || exit 1; \
    log="$(mktemp)"; \
    COMFYUI_MCP_HTTP_TOKEN= timeout 30 comfyctl relay serve > "$log" 2>&1; rc=$?; \
    if [ "$rc" != 2 ] || ! grep -q "Refusing to start" "$log"; then \
      echo "comfyrelay did not refuse to start without a token (exit $rc):" >&2; cat "$log" >&2; exit 1; \
    fi; \
    token=build-probe-0123456789abcdef0123456789; \
    COMFYUI_MCP_HTTP_TOKEN=$token MCP_HOST=127.0.0.1 comfyctl relay serve > "$log" 2>&1 & \
    pid=$!; \
    for i in $(seq 60); do \
      out="$(COMFYUI_MCP_HTTP_TOKEN=$token comfyctl relay probe --no-comfyui --timeout 5 2>&1)" && break; \
      case "$out" in *"FAIL  reachable"*) sleep 1 ;; *) break ;; esac; \
    done; \
    kill "$pid"; wait "$pid" 2>/dev/null; \
    case "$out" in *"probe: PASS"*) ;; *) echo "$out" >&2; cat "$log" >&2; exit 1 ;; esac; \
    rm -f "$log"

EXPOSE 9000

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["comfyctl", "relay", "serve"]
