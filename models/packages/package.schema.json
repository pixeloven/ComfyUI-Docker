{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixeloven.github.io/ComfyUI-Docker/schemas/model-package.json",
  "title": "ComfyUI model package",
  "description": "A capability and the files that deliver it, expressed so any consumer can rebuild it. Validated in CI; see documentation/decisions/0009, 0015 and 0019.",
  "type": "object",
  "required": [
    "package",
    "version",
    "description",
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "package": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "active",
        "legacy",
        "requires-credentials"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_comfyui": {
      "type": "string"
    },
    "deployed_comfyui": {
      "type": "string"
    },
    "requires_nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "auth": {
      "type": "object"
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "available": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "references_only": {
      "type": "boolean",
      "description": "True when this package REFERENCES files that other packages own, rather than owning them itself. A validation subset is the case: it selects files by failure mode from across the real packages. Ownership checks skip it, otherwise every entry reads as a file claimed twice."
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "name",
        "install",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "shared": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "install": {
          "type": "string",
          "pattern": "^models/"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "description": "`path` is REQUIRED on every entry, variants included. Without it the orphan check cannot tell whether a local file is claimed, which is how one orphan count reported 92 unmanaged files against a true figure of 53.",
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[^/].*",
          "description": "Local path relative to the models directory."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture_method": {
          "enum": [
            "tensor_keys",
            "civitai",
            "sidecar",
            "safetensors_header",
            "filename",
            "unknown"
          ]
        },
        "upstream_filename": {
          "type": "string"
        },
        "workflows": {
          "type": "integer",
          "minimum": 0
        },
        "tier": {
          "type": "array",
          "items": {
            "enum": [
              "local-16gb",
              "local-24gb",
              "cloud"
            ]
          }
        },
        "variant_of": {
          "type": "string",
          "description": "Set when this file is one precision of a model that ships several."
        },
        "requires_node": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 0,
          "description": "Every known origin, best-first per SOURCE_PRIORITY. The tail is what a fetcher falls back to.",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "unreconstructible": {
          "type": "boolean",
          "description": "True when no source could be located. The file is kept but CANNOT be rebuilt -- deleting it is irreversible. Must be explicit, never implied by an empty sources list."
        },
        "validates": {
          "enum": [
            "canonical",
            "mirror",
            "github_release",
            "civitai-keyed",
            "gated",
            "renamed-upstream",
            "unreconstructible"
          ],
          "description": "Which FAILURE MODE this entry exercises. Only meaningful in a validation subset, which is chosen per failure mode rather than as a representative sample."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sources": {
                "maxItems": 0
              }
            },
            "required": [
              "sources"
            ]
          },
          "then": {
            "required": [
              "unreconstructible"
            ],
            "properties": {
              "unreconstructible": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "huggingface_canonical",
            "github_release",
            "huggingface_mirror",
            "civitai"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "auth": {
          "enum": [
            "civitai",
            "huggingface"
          ]
        },
        "verified": {
          "type": "boolean",
          "description": "True only when the upstream digest was compared to ours."
        }
      }
    }
  }
}