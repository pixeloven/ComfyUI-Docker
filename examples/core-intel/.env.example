PUID=1000
PGID=1000
COMFY_PORT=8188
COMFY_ENABLE_MANAGER=true
COMFY_ENABLE_ASSETS=true
CLI_ARGS=

# Use `getent group video` and `getent group render` on the host.
VIDEO_GID=44
RENDER_GID=109

COMFY_CUSTOM_NODE_PATH=./data/custom_nodes
COMFY_DATASET_PATH=./data/datasets
COMFY_INPUT_PATH=./data/input
COMFY_MODEL_PATH=./data/models
COMFY_OUTPUT_PATH=./data/output
COMFY_TEMP_PATH=./data/temp
COMFY_USER_PATH=./data/user

#=====================================================================#
#                       Model fetching (opt-in)                       #
#=====================================================================#

# `docker compose --profile models up` materialises the models this lock
# declares, verifying every file against its sha256, before ComfyUI starts.
# Defaults to the small `preview` lock (9.5 MB); point at ../../comfy-lock.yaml
# for the full set.
COMFY_LOCK=../../locks/preview.yaml

# Credentials, read by HOST from the lock's `auth` map. Only needed for gated
# sources; public files fetch without them.
CIVITAI_TOKEN=
HF_TOKEN=
