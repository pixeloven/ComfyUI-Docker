# Docker
.env

# VSCode specific
*.code-workspace
/.vscode

# Service data
./data
./output


# Python
./.venv

# Scratch the release job writes into the workspace. Ignored so a stray
# `git add -A` in CI can never commit a build artifact back into the repo.
/dist/
/notes.md
/tags.txt
/IMAGE-DIGESTS.txt

# setuptools build detritus. It was tracked, so every `uv build` produced a
# spurious diff and could commit a stale version string back into the repo.
*.egg-info/
