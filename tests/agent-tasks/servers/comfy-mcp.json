{
  "mcpServers": {
    "comfy-mcp": {
      "command": "uv",
      "args": [
        "run", "--isolated", "--no-project", "--python", "3.12",
        "--with", "comfy-mcp==0.10.0",
        "--with", "comfy-cli==1.21.0",
        "--with", "mcp==${COMFY_MCP_SDK_VERSION:-2.0.0}",
        "--", "comfy-mcp"
      ],
      "env": {
        "COMFY_LOCAL_URL": "http://127.0.0.1:8188",
        "HOME": "${HARNESS_DATA:-/tmp/comfyui-harness}/comfy-mcp-home",
        "UV_CACHE_DIR": "${HARNESS_DATA:-/tmp/comfyui-harness}/uv-cache",
        "UV_PYTHON_INSTALL_DIR": "${HARNESS_DATA:-/tmp/comfyui-harness}/uv-python",
        "DO_NOT_TRACK": "1",
        "COMFY_NO_TELEMETRY": "1"
      }
    }
  }
}
